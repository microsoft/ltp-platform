[SETTINGS]
max-args=8

# Ignore imports when computing similarities.
ignore-imports=yes

ignored-modules=responses

[FORMAT]
max-line-length=130

[MASTER]
init-hook="from pylint.config import find_default_config_files;\
           import os, sys;\
           config_dir = os.path.dirname(next(find_default_config_files()));\
           sys.path.append(os.path.join(config_dir, './src/init.d'));\
           sys.path.append(os.path.join(config_dir, './src'));"

# Disable docstring check
disable=C0111

[BASIC]
# Good variable names which should always be accepted, separated by a comma
good-names=i,j,k,f,v