# REST Server Configuration
REST_SERVER_URI=http://localhost/rest-server

# Monitoring Services
PROMETHEUS_URI=http://localhost
GRAFANA_URI=http://localhost/grafana

# Storage Services
YARN_WEB_PORTAL_URI=http://localhost/yarn
WEBHDFS_URI=http://localhost/webhdfs
K8S_DASHBOARD_URI=http://localhost/kubernetes-dashboard

# Exporter Configuration
EXPORTER_PORT=9100
PROM_SCRAPE_TIME=300s

# Authentication
AUTHN_METHOD=basic

# Plugins Configuration (JSON array)
WEBPORTAL_PLUGINS=[]

# Server Configuration
SERVER_PORT=8080
NODE_ENV=development
LOG_LEVEL=info
