apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: moneo-gpu-exporter
spec:
  selector:
    matchLabels:
      app: moneo-gpu-exporter
  template:
    metadata:
      labels:
        app: moneo-gpu-exporter
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/path: "/metrics"
    spec:
      priorityClassName: pai-daemon-priority
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: vendor
                operator: In
                values: ["amd", "nvidia"]
      containers:
      - name: moneo-gpu-exporter
        image: {{ cluster_cfg["cluster"]["docker-registry"]["prefix"] }}job-exporter:{{ cluster_cfg["cluster"]["docker-registry"]["tag"] }}
        imagePullPolicy: Always
        securityContext:
          privileged: true
          capabilities:
            add:
              - SYS_ADMIN
        volumeMounts:
          - mountPath: /dev
            name: device-mount
        command:
        - "bash"
        - "moneo-gpu-exporter_entrypoint.sh"
        ports:
        - containerPort: {{ cluster_cfg["job-exporter"]["gpu-port"] }}
          hostPort: {{ cluster_cfg["job-exporter"]["gpu-port"] }}
          name: gpu
      volumes:
      - name: device-mount
        hostPath:
          path: /dev
{%- if cluster_cfg["cluster"]["docker-registry"]["secret-name"] %}
      imagePullSecrets:
      - name: {{ cluster_cfg["cluster"]["docker-registry"]["secret-name"] }}
{%- endif %}
      hostNetwork: true
      hostPID: true
      tolerations:
      - key: node.kubernetes.io/memory-pressure
        operator: "Exists"
      - key: node.kubernetes.io/disk-pressure
        operator: "Exists"
